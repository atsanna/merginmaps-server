# Ory Polis settings (see https://www.ory.sh/docs/polis)
DB_ENGINE=sql
DB_TYPE=postgres
DB_URL=postgres://postgres:postgres@db:5432/polis
# API keys accepted by Polis, SSO_SERVER_API_KEY of the server must be one of them
JACKSON_API_KEYS=fixme
# public URL of Polis (browser redirects), same as SSO_SERVER_URL of the server
EXTERNAL_URL=http://localhost:8081
NEXTAUTH_URL=http://localhost:8081
NEXTAUTH_SECRET=fixme
# admin UI login, comma separated email:password pairs
NEXTAUTH_ADMIN_CREDENTIALS=admin@example.com:fixme
IDP_ENABLED=true
