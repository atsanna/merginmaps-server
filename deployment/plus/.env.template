# Copy to .prod.env and fix the values marked "fixme".
# Community Edition settings (see deployment/community/.env.template for all of them)
MERGIN_BASE_URL=http://localhost:8080
CONTACT_EMAIL=admin@example.com
FLASK_APP=mergin_plus.wsgi
FLASK_DEBUG=0
MAINTENANCE_FILE=/data/MAINTENANCE
TEMP_DIR=/data/tmp
DB_HOST=db
DB_PASSWORD=postgres
DB_PORT=5432
SECRET_KEY=fixme
SECURITY_BEARER_SALT=fixme
SECURITY_EMAIL_SALT=fixme
SECURITY_PASSWORD_SALT=fixme
SECURITY_UNLOCK_SALT=fixme
MAIL_SUPPRESS_SEND=1
MAIL_DEFAULT_SENDER=mergin@example.com
LOCAL_PROJECTS=/data
USE_X_ACCEL=1
GEODIFF_WORKING_DIR=/data/geodiff
GEODIFF_LOGGER_LEVEL=2
BROKER_URL=redis://merginmaps-redis:6379/0
CELERY_RESULT_BACKEND=redis://merginmaps-redis:6379/0
ACCOUNT_EXPIRATION=1
GLOBAL_STORAGE=10737418240
PORT=5000
GEVENT_WORKER=True
NO_MONKEY_PATCH=False
DIAGNOSTIC_LOGS_DIR=/diagnostic_logs
OTEL_ENABLED=0

# Enterprise add-on (see server/mergin_plus/README.md)
USER_WORKSPACES_ALLOWED=true
WORKSPACE_STORAGE_SIZE=10737418240
WORKSPACE_CONTRIBUTORS_LIMIT=0
WORKSPACE_EXPIRATION=7
WORKSPACE_INVITATION_EXPIRATION=14
PROJECT_TRANSFER_EXPIRATION=7
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION=365
INSTANCE_NAME=
# web maps (docker-compose.maps.yml)
MAPS_ENABLED=false
OVERVIEW_DATA=/data/map_overviews
QGIS_SERVER_URL=http://merginmaps-qgis-server/ows/
QGIS_SERVER_DATA=/data/map_overviews
# single sign-on (docker-compose.sso.yml)
SSO_ENABLED=false
SSO_SERVER_URL=http://localhost:8081
SSO_SERVER_API_URL=http://merginmaps-polis:5225
SSO_SERVER_API_KEY=fixme
